# Server-only Supabase project credentials. Never prefix the service key with
# NEXT_PUBLIC_ or pass it to client components.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
SUPABASE_DB_PASSWORD=your-database-password
SUPABASE_DB_POOLER_HOST=aws-0-your-region.pooler.supabase.com

# Used to build signup confirmation and password-recovery callback links. Add
# this origin's /auth/confirm path to the Supabase Auth redirect allow list.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local authenticated Yjs server started by `npm run dev:yjs` or `npm run dev:all`.
NEXT_PUBLIC_YJS_WS_URL=ws://localhost:1234
YJS_HOST=127.0.0.1
YJS_PORT=1234

# Optional production hardening: require an exact browser Origin header.
# YJS_ALLOWED_ORIGIN=https://canvas.example.com
