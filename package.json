{
  "name": "qollab",
  "version": "0.1.0",
  "private": true,
  "astryx": {
    "theme": "./theme/generated/qollab-workshop.js"
  },
  "scripts": {
    "theme:build": "astryx theme build theme/qollab-workshop.ts --out theme/generated/qollab-workshop.css",
    "theme:check": "astryx theme build theme/qollab-workshop.ts --out theme/generated/qollab-workshop.css --check",
    "prebuild": "npm run verify:workspace && npm run theme:build",
    "dev": "next dev --turbopack",
    "dev:yjs": "node --watch --env-file=.env server/yjs-server.mjs",
    "dev:all": "concurrently -k -n WEB,YJS -c blue,yellow \"npm:dev\" \"npm:dev:yjs\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:buttons": "node --import tsx scripts/verify-buttons.ts",
    "verify:yjs": "node scripts/verify-yjs.mjs",
    "verify:schema": "node --env-file=.env scripts/verify-schema.mjs",
    "verify:version-history": "node --env-file=.env scripts/verify-version-history.mjs",
    "verify:rooms": "node --env-file=.env scripts/verify-room-management.mjs",
    "verify:room-icons": "node --env-file=.env scripts/verify-room-banners.mjs",
    "verify:breakouts": "node --env-file=.env scripts/verify-breakout-rooms.mjs",
    "verify:offline-sync": "node --env-file=.env --import tsx scripts/verify-offline-sync.ts",
    "verify:conflict-review": "node --require ./scripts/register-css.cjs --import tsx scripts/verify-conflict-review.ts",
    "verify:password-reset": "node --import tsx scripts/verify-password-reset.ts",
    "verify:account-profile": "node --import tsx scripts/verify-account-profile.ts",
    "verify:phase-3": "node --import tsx scripts/verify-phase-3.ts",
    "verify:phase-3-storage": "node --env-file=.env scripts/verify-phase-3-storage.mjs",
    "verify:phase-4": "node --require ./scripts/register-css.cjs --import tsx scripts/verify-phase-4.ts",
    "verify:saved-study-guides": "node --env-file=.env scripts/verify-saved-study-guides.mjs",
    "verify:serverless-collaboration": "node --env-file=.env scripts/verify-serverless-collaboration.mjs",
    "verify:vercel": "node --env-file=.env scripts/verify-vercel-deployment.mjs",
    "format:check": "prettier --check package.json tsconfig.json next.config.ts postcss.config.mjs eslint.config.mjs theme/qollab-workshop.ts \"src/**/*.{ts,tsx,css}\" \"server/**/*.mjs\" \"scripts/**/*.{mjs,cjs,ts}\" README.md",
    "verify:workspace": "node scripts/verify-workspace.mjs",
    "pretypecheck": "npm run verify:workspace",
    "verify:collaboration-lifecycle": "node --import tsx scripts/verify-collaboration-lifecycle.ts",
    "verify:collaboration-persistence": "node scripts/verify-collaboration-persistence.mjs",
    "verify:study-tools": "node --import tsx scripts/verify-study-tools.ts",
    "verify:workspace-shell": "node --require ./scripts/register-css.cjs --import tsx scripts/verify-workspace-shell.ts",
    "verify:design-system": "node --import tsx scripts/verify-design-system.ts"
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.5.0",
    "@astryxdesign/core": "^0.5.0",
    "@astryxdesign/theme-neutral": "^0.5.0",
    "@stylexjs/stylex": "^0.19.0",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.7",
    "@tiptap/core": "3.28.0",
    "@tiptap/extension-collaboration": "3.28.0",
    "@tiptap/extension-collaboration-caret": "3.28.0",
    "@tiptap/extension-placeholder": "3.28.0",
    "@tiptap/pm": "3.28.0",
    "@tiptap/react": "3.28.0",
    "@tiptap/starter-kit": "3.28.0",
    "@vercel/functions": "3.8.0",
    "lucide": "1.24.0",
    "morphicons": "1.7.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-pdf": "10.4.1",
    "ws": "8.21.1",
    "y-indexeddb": "9.0.12",
    "y-websocket": "2.1.0",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "concurrently": "10.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "fake-indexeddb": "6.2.5",
    "postcss": "8.5.19",
    "prettier": "3.9.5",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
